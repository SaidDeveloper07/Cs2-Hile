// ======================== WORLD TO SCREEN ========================
bool WorldToScreen(const Vector3& pos, Vector2& screen, const ViewMatrix& vm, int width, int height) {
    float w = vm.matrix[3][0] * pos.x + vm.matrix[3][1] * pos.y + vm.matrix[3][2] * pos.z + vm.matrix[3][3];
    if (w < 0.01f) return false;

    float x = vm.matrix[0][0] * pos.x + vm.matrix[0][1] * pos.y + vm.matrix[0][2] * pos.z + vm.matrix[0][3];
    float y = vm.matrix[1][0] * pos.x + vm.matrix[1][1] * pos.y + vm.matrix[1][2] * pos.z + vm.matrix[1][3];

    screen.x = (width / 2.0f) + (width / 2.0f) * (x / w);
    screen.y = (height / 2.0f) - (height / 2.0f) * (y / w);
    return true;
}

// ======================== ENTITY LIST ========================
std::vector<Entity> GetEntities(Memory& mem, uintptr_t localPawn) {
    std::vector<Entity> list;
    uintptr_t entityList = mem.Read<uintptr_t>(mem.clientBase + offsets::dwEntityList);
    if (!entityList) return list;

    for (int i = 1; i < 64; ++i) {
        uintptr_t listEntry = mem.Read<uintptr_t>(entityList + (8 * (i & 0x7FFF) >> 9) + 16);
        if (!listEntry) continue;

        uintptr_t controller = mem.Read<uintptr_t>(listEntry + 120 * (i & 0x1FF));
        if (!controller) continue;

        uint32_t pawnHandle = mem.Read<uint32_t>(controller + offsets::m_hPlayerPawn);
        if (!pawnHandle) continue;

        uintptr_t listEntry2 = mem.Read<uintptr_t>(entityList + 0x8 * ((pawnHandle & 0x7FFF) >> 9) + 16);
        if (!listEntry2) continue;

        uintptr_t pawn = mem.Read<uintptr_t>(listEntry2 + 120 * (pawnHandle & 0x1FF));
        if (!pawn || pawn == localPawn) continue;

        int health = mem.Read<int>(pawn + offsets::m_iHealth);
        int lifeState = mem.Read<uint8_t>(pawn + offsets::m_lifeState);
        if (health <= 0 || lifeState != 0) continue;

        Entity e;
        e.controller = controller;
        e.pawn = pawn;
        e.health = health;
        e.team = mem.Read<uint8_t>(pawn + offsets::m_iTeamNum);
        e.armor = mem.Read<int>(pawn + offsets::m_ArmorValue);
        e.alive = true;
        e.scoped = mem.Read<bool>(pawn + offsets::m_bIsScoped);

        uintptr_t sceneNode = mem.Read<uintptr_t>(pawn + offsets::m_pGameSceneNode);
        if (sceneNode) {
            e.origin = mem.Read<Vector3>(sceneNode + offsets::m_vecAbsOrigin);
            // Head approx (bone 6 later)
            e.head = { e.origin.x, e.origin.y, e.origin.z + 72.0f };
        }

        list.push_back(e);
    }
    return list;
}

// ======================== AIMBOT ========================
void Aimbot(Memory& mem, const std::vector<Entity>& entities, uintptr_t localPawn, int localTeam, const ViewMatrix& vm, int width, int height) {
    if (!Zeldox::aimbot_enabled || !(GetAsyncKeyState(Zeldox::aimbot_key) & 0x8000))
        return;

    Vector3 localOrigin = mem.Read<Vector3>(localPawn + offsets::m_vOldOrigin);
    float bestFov = Zeldox::aimbot_fov;
    Vector3 bestAngle{};
    bool found = false;

    for (const auto& e : entities) {
        if (Zeldox::aimbot_team_check && e.team == localTeam) continue;

        Vector2 screen;
        if (!WorldToScreen(e.head, screen, vm, width, height)) continue;

        float dx = screen.x - width / 2.0f;
        float dy = screen.y - height / 2.0f;
        float fov = sqrtf(dx * dx + dy * dy);

        if (fov < bestFov) {
            bestFov = fov;
            // Calculate angle
            Vector3 delta = e.head - localOrigin;
            float hyp = delta.Length();
            bestAngle.x = -asinf(delta.z / hyp) * (180.0f / 3.14159265f);
            bestAngle.y = atan2f(delta.y, delta.x) * (180.0f / 3.14159265f);
            found = true;
        }
    }

    if (found) {
        Vector3 current = mem.Read<Vector3>(mem.clientBase + offsets::dwViewAngles);
        Vector3 delta = bestAngle - current;
        // Normalize yaw
        while (delta.y > 180) delta.y -= 360;
        while (delta.y < -180) delta.y += 360;

        Vector3 finalAng;
        finalAng.x = current.x + delta.x / Zeldox::aimbot_smooth;
        finalAng.y = current.y + delta.y / Zeldox::aimbot_smooth;
        finalAng.z = 0;

        mem.Write<Vector3>(mem.clientBase + offsets::dwViewAngles, finalAng);
    }
}

// ======================== TRIGGERBOT ========================
void Triggerbot(Memory& mem, uintptr_t localPawn) {
    if (!Zeldox::triggerbot_enabled || !(GetAsyncKeyState(Zeldox::triggerbot_key) & 0x8000))
        return;

    int crosshairId = mem.Read<int>(localPawn + offsets::m_iIDEntIndex);
    if (crosshairId > 0) {
        std::this_thread::sleep_for(std::chrono::milliseconds(Zeldox::triggerbot_delay));
        // Force attack (write to +attack button state or mouse event)
        mouse_event(MOUSEEVENTF_LEFTDOWN, 0, 0, 0, 0);
        std::this_thread::sleep_for(std::chrono::milliseconds(10));
        mouse_event(MOUSEEVENTF_LEFTUP, 0, 0, 0, 0);
    }
}

// ======================== NO FLASH ========================
void NoFlash(Memory& mem, uintptr_t localPawn) {
    if (!Zeldox::no_flash) return;
    float flash = mem.Read<float>(localPawn + offsets::m_flFlashDuration);
    if (flash > 0.0f)
        mem.Write<float>(localPawn + offsets::m_flFlashDuration, 0.0f);
}

