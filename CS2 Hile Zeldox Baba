void HandleInput() {
    if (GetAsyncKeyState(VK_INSERT) & 1) Zeldox::menu_open = !Zeldox::menu_open;
    if (GetAsyncKeyState(VK_F1) & 1) Zeldox::aimbot_enabled = !Zeldox::aimbot_enabled;
    if (GetAsyncKeyState(VK_F2) & 1) Zeldox::aimbot_team_check = !Zeldox::aimbot_team_check;
    if (GetAsyncKeyState(VK_F3) & 1) Zeldox::aimbot_fov = max(1.0f, Zeldox::aimbot_fov - 0.5f);
    if (GetAsyncKeyState(VK_F4) & 1) Zeldox::aimbot_fov += 0.5f;
    if (GetAsyncKeyState(VK_F5) & 1) Zeldox::aimbot_smooth = max(1.0f, Zeldox::aimbot_smooth - 0.5f);
    if (GetAsyncKeyState(VK_F6) & 1) Zeldox::aimbot_smooth += 0.5f;
    if (GetAsyncKeyState(VK_F7) & 1) Zeldox::triggerbot_enabled = !Zeldox::triggerbot_enabled;
    if (GetAsyncKeyState(VK_F8) & 1) Zeldox::esp_enabled = !Zeldox::esp_enabled;
    if (GetAsyncKeyState(VK_F9) & 1) Zeldox::esp_box = !Zeldox::esp_box;
    if (GetAsyncKeyState(VK_F10) & 1) Zeldox::esp_skeleton = !Zeldox::esp_skeleton;
    if (GetAsyncKeyState(VK_F11) & 1) Zeldox::esp_health = !Zeldox::esp_health;
    if (GetAsyncKeyState(VK_F12) & 1) Zeldox::esp_name = !Zeldox::esp_name;
    if (GetAsyncKeyState('1') & 1) Zeldox::no_flash = !Zeldox::no_flash;
    if (GetAsyncKeyState('2') & 1) Zeldox::bhop = !Zeldox::bhop;
    if (GetAsyncKeyState('3') & 1) Zeldox::radar_hack = !Zeldox::radar_hack;
}

// ======================== MAIN ========================
int main() {
    SetConsoleTitleA("Zeldox | CS2 External");
    Memory mem;

    printf("[Zeldox] Waiting for cs2.exe...\n");
    while (!mem.Attach(L"cs2.exe")) {
        std::this_thread::sleep_for(std::chrono::seconds(1));
    }
    printf("[Zeldox] Attached. PID: %lu\n", mem.pid);

    mem.clientBase = mem.GetModuleBase(L"client.dll");
    if (!mem.clientBase) {
        printf("[Zeldox] client.dll not found.\n");
        return 1;
    }
    printf("[Zeldox] client.dll @ 0x%llX\n", mem.clientBase);
    printf("[Zeldox] Ready. INSERT = menu\n");

    int width = GetSystemMetrics(SM_CXSCREEN);
    int height = GetSystemMetrics(SM_CYSCREEN);

    while (true) {
        HandleInput();

        if (Zeldox::menu_open)
            DrawMenu();

        uintptr_t localPawn = mem.Read<uintptr_t>(mem.clientBase + offsets::dwLocalPlayerPawn);
        if (!localPawn) {
            std::this_thread::sleep_for(std::chrono::milliseconds(50));
            continue;
        }

        int localTeam = mem.Read<uint8_t>(localPawn + offsets::m_iTeamNum);
        ViewMatrix vm = mem.Read<ViewMatrix>(mem.clientBase + offsets::dwViewMatrix);

        auto entities = GetEntities(mem, localPawn);

        Aimbot(mem, entities, localPawn, localTeam, vm, width, height);
        Triggerbot(mem, localPawn);
        NoFlash(mem, localPawn);
        BunnyHop(mem, localPawn);

        // ESP rendering would go here with overlay (GDI / ImGui / DirectX)
        // For pure external console this is the logic core.

        std::this_thread::sleep_for(std::chrono::milliseconds(1));
    }

    return 0;
}
